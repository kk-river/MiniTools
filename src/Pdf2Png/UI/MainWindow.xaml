<adonisControls:AdonisWindow
    x:Class="Pdf2Png.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:wpftk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:local="clr-namespace:Pdf2Png.UI"
    mc:Ignorable="d"
    TextElement.FontSize="16"
    TextElement.FontFamily="Segoe UI"
    AllowDrop="True"
    Drop="OnDrop"
    IconVisibility="Collapsed"
    TitleVisibility="Visible"
    PlaceTitleBarOverContent="True"
    PreviewDragOver="OnPreviewDragOver"
    Title="Pdf2Png" Height="720" Width="1280"
    d:DataContext="{d:DesignInstance local:MainWindowViewModel}">

    <adonisControls:AdonisWindow.TitleBarContent>
        <TextBlock Margin="80 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding PdfDocument.Filename, Mode=OneWay}"/>
    </adonisControls:AdonisWindow.TitleBarContent>

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static adonisUi:Styles.ToggleSwitch}}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Focusable" Value="False"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxDefaultStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MaxLines" Value="1"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>

            <Style x:Key="HeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="0 0 0 3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*" MaxWidth="400" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Path=TitleBarActualHeight, RelativeSource={RelativeSource AncestorType={x:Type adonisControls:AdonisWindow}}}"
                           d:Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <wpftk:VirtualizingWrapPanel SpacingMode="None"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Margin="5" Padding="0" Focusable="False" BorderThickness="0"
                                      IsChecked="{Binding IsSelected}"
                                      Style="{StaticResource {x:Static adonisUi:Styles.DefaultToAccentToggleButton}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Width="{Binding ViewModel.ThumbnailWidth, Mode=OneWay}"
                                       Height="{Binding ViewModel.ThumbnailHeight, Mode=OneWay}"
                                       Source="{Binding Thumbnail.Value, Mode=OneWay}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Stretch" Value="Uniform"/>
                                            <Style.Triggers>
                                                <!-- 後にある方が優先（前から順に判定してるだけ？） -->
                                                <DataTrigger Binding="{Binding ViewModel.FillThumbnail}" Value="True">
                                                    <Setter Property="Stretch" Value="UniformToFill"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ViewModel.KeepThumbnailAspectRatio}" Value="False">
                                                    <Setter Property="Stretch" Value="Fill"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <ContentControl Grid.RowSpan="2" Width="40" Height="40" Focusable="False"
                                                ContentTemplate="{StaticResource {x:Static adonisUi:Templates.LoadingCircle}}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail.Value}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <Grid Width="25" Height="25" Margin="0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Path Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Stretch="Uniform"
                                          StrokeThickness="4" Stroke="Black"
                                          Data="M0,0 M100,80 M0,20 L40,60 L100,0"/>
                                    <Path Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Stretch="Uniform"
                                          StrokeThickness="2" Stroke="White"
                                          Data="M0,0 M100,80 M7,27 L40,60 L93,7"/>
                                </Grid>

                                <WrapPanel Grid.Row="1" Margin="5 0">
                                    <TextBlock Text="{Binding Size.Width}"/>
                                    <TextBlock Text="x"/>
                                    <TextBlock Text="{Binding Size.Height}"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Margin="5 0" HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} / {1}">
                                            <Binding Path="PageNo"/>
                                            <Binding Path="ViewModel.PdfDocument.Pages.Value.Count"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" Height="3"
                     VerticalAlignment="Top"
                     Foreground="{StaticResource {x:Static adonisUi:Brushes.SuccessBrush}}"
                     Value="{Binding PdfDocument.CreatedThumbnailCount.Value}"
                     Maximum="{Binding PdfDocument.Pages.Value.Count}"
                     adonisExtensions:ProgressBarExtension.IsProgressAnimationEnabled="False">
            <!-- Converterだとなぜか初期値がうまく反映されないので -->
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PdfDocument.IsLoading.Value}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Visibility="{Binding Loading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{StaticResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="1" Width="50" Height="50" Focusable="False"
                            ContentTemplate="{StaticResource {x:Static adonisUi:Templates.LoadingCircle}}"/>
            <TextBlock Grid.Row="3" HorizontalAlignment="Center"
                       FontSize="20" Text="Now Retrieving..."/>
        </Grid>

        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
            <GroupBox Margin="0 0 0 5" Padding="0">
                <GroupBox.Header>
                    <Grid Margin="8 0 8 0" Height="{Binding Path=TitleBarActualHeight, RelativeSource={RelativeSource AncestorType={x:Type adonisControls:AdonisWindow}}}">
                        <TextBlock VerticalAlignment="Center" Text="Display Settings"/>
                    </Grid>
                </GroupBox.Header>

                <StackPanel Margin="8 8 8 8">
                    <TextBlock Style="{StaticResource HeadingStyle}" Text="Thumbnail Size"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 TextAlignment="Right"
                                 ToolTip="Thumbnail Width (px)"
                                 adonisExtensions:WatermarkExtension.Watermark="Width (px)"
                                 Text="{Binding ThumbnailWidth, UpdateSourceTrigger=PropertyChanged}"/>
                        <Path Grid.Column="1" Margin="5 0" VerticalAlignment="Center"
                              Stroke="White" Data="M0,0 L8,8 M8,0 L0,8 M10,10"/>
                        <TextBox Grid.Column="2"
                                 TextAlignment="Right"
                                 ToolTip="Thumbnail Height (px)"
                                 adonisExtensions:WatermarkExtension.Watermark="Height (px)"
                                 Text="{Binding ThumbnailHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <WrapPanel Margin="0 6 0 0">
                        <CheckBox Width="32" VerticalAlignment="Center" IsChecked="{Binding KeepThumbnailAspectRatio}"/>
                        <TextBlock VerticalAlignment="Center" Padding="0 0 0 2" FontSize="14" Text="Keep Aspect Ratio"/>
                    </WrapPanel>

                    <WrapPanel Margin="0 6 0 0">
                        <CheckBox Width="32" VerticalAlignment="Center"
                                  IsEnabled="{Binding KeepThumbnailAspectRatio}"
                                  IsChecked="{Binding FillThumbnail}"/>
                        <TextBlock VerticalAlignment="Center" Padding="0 0 0 2" FontSize="14" Text="Fill"/>
                    </WrapPanel>

                    <Button Margin="0 15 0 0" Content="Reload"
                            Command="{Binding ReloadPdfCommand}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1"
                      Margin="0 0 0 5" Padding="0">
                <GroupBox.Header>
                    <Grid Margin="8 0 8 0" Height="{Binding Path=TitleBarActualHeight, RelativeSource={RelativeSource AncestorType={x:Type adonisControls:AdonisWindow}}}">
                        <TextBlock VerticalAlignment="Center" Text="Export Settings"/>
                    </Grid>
                </GroupBox.Header>

                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Select All"
                            Command="{Binding SelectAllCommand}"/>

                        <Button Grid.Column="2" Content="Unselect All"
                            Command="{Binding UnselectAllCommand}"/>
                    </Grid>

                    <TextBlock Margin="0 8 0 0" Style="{StaticResource HeadingStyle}" Text="Format"/>
                    <ComboBox HorizontalAlignment="Left" VerticalContentAlignment="Center"
                              Padding="8 1 8 3"
                              Width="150"
                              ItemsSource="{Binding FormatOptions}"
                              SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding SelectedFormat, Mode=TwoWay}"/>

                    <TextBlock Margin="0 8 0 0" Style="{StaticResource HeadingStyle}" Text="Output Size"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 TextAlignment="Right"
                                 ToolTip="Output Width (px)"
                                 adonisExtensions:WatermarkExtension.Watermark="Width (px)"
                                 Text="{Binding OutputWidth, UpdateSourceTrigger=PropertyChanged}"/>
                        <Path Grid.Column="1" Margin="5 0" VerticalAlignment="Center"
                              Stroke="White" Data="M0,0 L8,8 M8,0 L0,8 M10,10"/>
                        <TextBox Grid.Column="2"
                                 TextAlignment="Right"
                                 ToolTip="Output Height (px)"
                                 adonisExtensions:WatermarkExtension.Watermark="Height (px)"
                                 Text="{Binding OutputHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <WrapPanel Margin="0 6 0 0">
                        <CheckBox Width="32" VerticalAlignment="Center" IsChecked="{Binding KeepOutputAspectRatio}"/>
                        <TextBlock VerticalAlignment="Center" Padding="0 0 0 2" FontSize="14" Text="Keep Aspect Ratio"/>
                    </WrapPanel>

                    <WrapPanel Margin="0 6 0 0">
                        <CheckBox Width="32" VerticalAlignment="Center"
                                  IsEnabled="{Binding KeepOutputAspectRatio}"
                                  IsChecked="{Binding FillOutput}"/>
                        <TextBlock VerticalAlignment="Center" Padding="0 0 0 2" FontSize="14" Text="Fill"/>
                    </WrapPanel>

                    <TextBlock Margin="0 8 0 0" Style="{StaticResource HeadingStyle}" Text="Target Directory"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="ToolTip" Value="{Binding OutputDir}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputDir}" Value="">
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Height="26" Padding="10 -20" FontSize="14" Content="Browse..." Click="OnOpenDirectoryPicker"/>
                    </Grid>

                    <TextBlock Margin="0 8 0 0" Style="{StaticResource HeadingStyle}" Text="Filename"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputFilename, UpdateSourceTrigger=PropertyChanged}"/>
                        <!--<Button Grid.Column="2" Height="26" Padding="10 -20" FontSize="14" Content="Hint..."/>-->
                    </Grid>
                    <TextBlock FontSize="14" Text="{Binding OutputFilenameSample, Mode=OneWay, StringFormat=Export as: {0}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="ToolTip" Value="{Binding OutputFilenameSample}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutputFilenameSample}" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Margin="0 15 0 0" Content="Export"
                            Command="{Binding ExportPagesToFileCommand}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</adonisControls:AdonisWindow>
